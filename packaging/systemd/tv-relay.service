# Template: install as /etc/systemd/system/tv-relay.service.
# Video relay for creator channels: docs/superpowers/specs/2026-10-09-creator-channels-and-cast-design.md.
# Listens on loopback only; nginx proxies https://<site>/TV/cast/ to the page port
# (packaging/nginx/tv-relay.conf). Replace <site> with the site's host name.
# Every unit and drop-in, and the install order: docs/development/host-setup.md.
[Unit]
Description=AI Passport TV video relay (Bilibili creator channels and casting)
After=network-online.target
Wants=network-online.target

[Service]
User=tvserver
Group=tvserver
WorkingDirectory=/opt/ai-passport-tv
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3.11 -m server.relay --state /var/lib/ai-passport-tv/relay-state.json --channels-out /var/lib/ai-passport-tv/relay-channels.txt --key-file /etc/ai-passport-tv/relay-key --events-out /var/lib/ai-passport-tv/relay-events.json --cstone /etc/ai-passport-tv/cstone.json --main-channels /var/lib/ai-passport-tv/channels.txt --groups-out /var/lib/ai-passport-tv/channel-groups.json --now-playing /var/lib/ai-passport-tv/now-playing.json --extra-device Passport:/var/lib/ai-passport-tv-passport/now-playing.json:/var/lib/ai-passport-tv-passport/relay-events.json --remote-url-out /var/lib/ai-passport-tv/remote-url.txt --public-url https://<site> --ffmpeg /opt/ai-passport-tv/ffmpeg-btbn-8.1
Restart=always
RestartSec=3
# Remuxing only (-c copy), so it needs little CPU; keep the websites responsive.
Nice=10
CPUQuota=50%
MemoryMax=200M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-passport-tv
# Each --extra-device's files must be writable too: the AI Passport's are in
# tv-relay.service.d/passport-events.conf.
PrivateTmp=true

[Install]
WantedBy=multi-user.target
