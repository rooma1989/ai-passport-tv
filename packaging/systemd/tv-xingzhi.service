# Template: install as /etc/systemd/system/tv-xingzhi.service.
# Steps and the reasons for each setting: docs/boards/xingzhi-cube-154.md ("Cloud server").
# Every unit and drop-in, and the install order: docs/development/host-setup.md.
# Drop-in in tv-xingzhi.service.d/: voice.conf (voice control, optional).
[Unit]
Description=AI Passport TV media server for the Xingzhi Cube 1.54 (240x180, port 8098)
After=network-online.target tv-relay.service
Wants=network-online.target

[Service]
User=tvserver
Group=tvserver
WorkingDirectory=/opt/ai-passport-tv
Environment=PYTHONUNBUFFERED=1
Environment=TV_GEOMETRY=240x180
# 3 Mbps server shared with websites: 15 fps, 200 kB/s of picture (~1.8 Mbps with sound).
Environment=TV_FPS=15
Environment=TV_RATE_START=200000
Environment=TV_DATA_DIR=/var/lib/ai-passport-tv
Environment=TV_ALLOW_PUBLIC=1
# Some sources take 15-30 s to open from a mainland host; the device waits 45 s.
Environment=TV_DECODER_CONNECT_TIMEOUT_S=30
Environment=TV_CHANNELS_FILE=/var/lib/ai-passport-tv/channels.txt
# Creator channels written by tv-relay.service; listed first, re-read between sessions.
Environment=TV_RELAY_CHANNELS_FILE=/var/lib/ai-passport-tv/relay-channels.txt
# Cast events from tv-relay.service: switch the device to "cast" and back.
Environment=TV_RELAY_EVENTS_FILE=/var/lib/ai-passport-tv/relay-events.json
# Phone remote: group overrides, what is playing, and the QR address for the status page.
Environment=TV_CHANNEL_GROUPS_FILE=/var/lib/ai-passport-tv/channel-groups.json
Environment=TV_NOW_PLAYING_FILE=/var/lib/ai-passport-tv/now-playing.json
Environment=TV_REMOTE_URL_FILE=/var/lib/ai-passport-tv/remote-url.txt
# Voice control: tv-xingzhi.service.d/voice.conf.
ExecStart=/usr/bin/python3.11 -m server.tv_server live --channel ch000 --port 8098 --ffmpeg /opt/ai-passport-tv/ffmpeg-btbn-8.1 --token-file /etc/ai-passport-tv/token
Restart=always
RestartSec=3
# Keep the websites on this host responsive.
Nice=10
CPUQuota=100%
MemoryMax=600M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-passport-tv /tmp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
