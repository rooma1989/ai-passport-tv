[Desktop Entry]
Type=Application
Name=小鼠电视
Name[en]=RooTV
Comment=小鼠电视（RooTV，原名小智电视）电脑客户端：给家里的小电视推流
Comment[en]=RooTV (formerly Xiaozhi TV) PC client: streams to the TV devices at home
# For a folder other than ~/rootv, put its full path after Exec= instead.
# (\\$ is how the Desktop Entry format writes a literal $ inside a quoted argument.)
Exec=sh -c "\\$HOME/rootv/rootv"
Icon=rootv
Terminal=false
Categories=AudioVideo;Video;
